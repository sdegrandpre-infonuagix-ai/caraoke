# Caraoke environment template — copy to .env and fill in. NEVER commit real secrets.

# Runtime
NODE_ENV=development
API_PORT=3000

# Integration adapter selection (NFR20): live | mock
CARAOKE_INTEGRATIONS=mock

# AWS / residency (ca-central-1 only — NFR10)
AWS_REGION=ca-central-1

# Cognito (auth) — placeholders for later epics
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Data stores — placeholders for later epics
DATABASE_URL=
REDIS_URL=
