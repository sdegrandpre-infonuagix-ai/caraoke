public-hoist-pattern[]=tsx
# Babel resolves preset/plugin names relative to the config dir (apps/mobile), but pnpm's
# strict node_modules nests them under the presets that pull them in. Hoist all Babel packages
# so babel.config's presets (and the plugins THEY load by name) resolve during Metro bundling
# and expo-updates' manifest step. Fixes "MODULE_NOT_FOUND" for babel plugins on EAS.
public-hoist-pattern[]=*babel*
public-hoist-pattern[]=@babel/*
public-hoist-pattern[]=babel-plugin-*
public-hoist-pattern[]=babel-preset-*
