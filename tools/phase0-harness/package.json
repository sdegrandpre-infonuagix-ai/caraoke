{
  "name": "phase0-harness",
  "version": "0.0.0",
  "private": true,
  "description": "⚠️ THROWAWAY Phase 0 duet validation harness (Story 1.3). NOT part of the pnpm workspace.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "server": "node --import tsx server/index.ts",
    "report": "node --import tsx measure/generate-report.ts",
    "test": "node --import tsx --test app/src/lib/*.test.ts measure/*.test.ts"
  },
  "dependencies": {
    "expo": "56.0.12",
    "expo-router": "~56.2.11",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-webrtc": "^124.0.0",
    "@config-plugins/react-native-webrtc": "^15.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/ws": "8.5.13",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "ws": "8.18.0"
  }
}
