{
  "name": "@caraoke/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types and Zod schemas for Caraoke (session, pairing, events, error envelope).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@caraoke/config": "workspace:*",
    "eslint": "9.18.0",
    "rimraf": "6.0.1",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
